{
	"id": "/",
	"name": "Pi Pocket Console",
	"short_name": "Pi Pocket",
	"description": "A private, iPhone-first remote controller for Pi coding-agent instances.",
	"lang": "en",
	"dir": "ltr",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"display_override": ["standalone", "minimal-ui"],
	"orientation": "any",
	"background_color": "#080b0e",
	"theme_color": "#080b0e",
	"categories": ["developer", "productivity", "utilities"],
	"icons": [
		{
			"src": "/icon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any"
		},
		{
			"src": "/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any maskable"
		}
	],
	"prefer_related_applications": false
}
